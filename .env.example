# ============================================================
# GraphOne AI Intelligence Search — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://graphone:graphone@localhost:5432/graphone
DATABASE_POOL_SIZE=10

# --- Redis (quota, caching, queue) ---
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- LLM Providers (fallback chain: Gemini → Groq → DeepSeek) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- GitHub API ---
GITHUB_TOKEN=
GITHUB_STARS_CACHE_TTL_SECONDS=86400

# --- Google Sheets Export ---
# Path to the Google Service Account JSON key file
GOOGLE_SHEETS_CREDENTIALS_PATH=
# ID of the target Google Sheet (from the URL)
GOOGLE_SHEET_ID=

# --- Clerk Authentication (Next.js) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Object Storage (Cloudflare R2 / S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=graphone-raw
R2_ENDPOINT_URL=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Crawler Settings ---
CRAWLER_DEFAULT_TIMEOUT_SECONDS=30
CRAWLER_MAX_RETRIES=3
CRAWLER_PER_DOMAIN_CONCURRENCY=2
CRAWLER_USER_AGENT=GraphOneBot/1.0 (+https://graphone.ai/bot)

# --- Pipeline ---
PIPELINE_BATCH_SIZE=100
PIPELINE_MAX_WORKERS=4
